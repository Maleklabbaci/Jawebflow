# ---------------------------------------------------------------------------
# Copy this file to .env (never committed) — `npm run dev` and `npm start`
# load it automatically.
#
# IMPORTANT: placeholders must be replaced by REAL values. Values that still
# look like placeholders ("MY_GEMINI_API_KEY", "your_key", "change_me", ...) are
# treated as absent, so the AI replies stay disabled instead of failing with an
# obscure provider error. Check what the server actually sees on GET /api/health
# ---------------------------------------------------------------------------

# AI PROVIDER (at least one is required for the assistant to answer)
# GEMINI_API_KEY is the primary provider: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional OpenAI-compatible fallback for customer assistants (not for the
# official JawebFlow assistant, which stays on Gemini).
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash

# APP_URL: public URL where this app is hosted (used for payment callbacks,
# OAuth redirects and API endpoints).
APP_URL=

# SERVER: port to listen on (default 3000) and, for the dev server only, the
# list of hosts allowed to reach it (defaults to all hosts, which is required
# behind a proxy/preview URL).
# PORT=3000
# ALLOWED_HOSTS=jawebflow.dz,www.jawebflow.dz

# FIREBASE ADMIN (server-side Firestore: assistant plans, usage counters,
# Instagram tokens, self-learning memory). Optional: without credentials the
# API runs in degraded mode (the AI still answers using the data sent by the
# widget/dashboard). On Google Cloud (Cloud Run, App Engine) the attached
# service account is used automatically; locally, point this to a service
# account JSON key.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# Online Payment Integration (Stripe & SlickPay DZD / CIB / Edahabia)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SLICKPAY_PUBLIC_KEY=
SLICKPAY_SECRET_KEY=

# Instagram Login / Meta Graph API (server-side only)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI="https://jawebflow.pages.dev/"
# Webhook verification token configured in the Meta app dashboard
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
