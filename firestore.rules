rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsAssistant(assistantId) {
      return signedIn() && get(/databases/$(database)/documents/assistants/$(assistantId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /assistants/{assistantId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /prospects/{prospectId} {
      allow create: if request.resource.data.assistantId is string
        && request.resource.data.assistantId.size() > 0;
      allow read, update, delete: if ownsAssistant(resource.data.assistantId);
    }

    match /interaction_events/{eventId} {
      allow create: if request.resource.data.assistantId is string;
      allow read, update, delete: if ownsAssistant(resource.data.assistantId);
    }

    match /instagram_integrations/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /conversation_contexts/{contextId} {
      allow create: if request.resource.data.assistantId is string;
      allow read, update, delete: if ownsAssistant(resource.data.assistantId);
    }

    match /evolving_memories/{assistantId} {
      allow read, write: if ownsAssistant(assistantId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
