/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With

# Le moteur d'appel vocal est importé par le widget depuis le site du marchand :
# sans ces en-têtes, le navigateur refuse le module (CORS) et le micro ne
# s'ouvre jamais.
/cdn/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  # Une heure suffit : les fichiers sont appelés avec `?v=` (cache-busting) et
  # une correction doit atteindre les visiteurs sans attendre 24 h.
  Cache-Control: public, max-age=3600
