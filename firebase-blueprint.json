{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil utilisateur et informations d'entreprise",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "companyName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Assistant": {
      "title": "Assistant",
      "description": "Configuration de l'assistant IA, base de connaissances et personnalisation de la bulle",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessName": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "businessCategory": { "type": "string" },
        "businessDescription": { "type": "string" },
        "faqText": { "type": "string" },
        "pricingServicesText": { "type": "string" },
        "specialRulesText": { "type": "string" },
        "assistantTone": { "type": "string" },
        "languages": { "type": "object" },
        "autoLeadCapture": { "type": "boolean" },
        "whatsappEscalation": { "type": "string" },
        "widgetId": { "type": "string" },
        "widgetConfig": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "businessName", "widgetId"]
    },
    "Prospect": {
      "title": "Prospect",
      "description": "Visiteurs et prospects capturés par l'assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "assistantId": { "type": "string" },
        "userId": { "type": "string" },
        "visitorId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "need": { "type": "string" },
        "status": { "type": "string" },
        "referer": { "type": "string" },
        "currentPage": { "type": "string" },
        "userAgent": { "type": "string" },
        "language": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["assistantId", "userId", "visitorId"]
    },
    "ConversationContext": {
      "title": "ConversationContext",
      "description": "Historique des échanges et contexte évolutif d'apprentissage de l'assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "assistantId": { "type": "string" },
        "sessionId": { "type": "string" },
        "channel": { "type": "string" },
        "userMessage": { "type": "string" },
        "assistantResponse": { "type": "string" },
        "detectedPreferences": { "type": "object" },
        "detectedTone": { "type": "string" },
        "topics": { "type": "array" },
        "timestamp": { "type": "string" }
      },
      "required": ["assistantId", "userMessage", "assistantResponse"]
    },
    "EvolvingMemory": {
      "title": "EvolvingMemory",
      "description": "Synthèse du contexte évolutif et de l'adaptation du ton et de l'expertise",
      "type": "object",
      "properties": {
        "assistantId": { "type": "string" },
        "preferredTone": { "type": "string" },
        "adaptedExpertise": { "type": "string" },
        "learnedPatterns": { "type": "array" },
        "userPreferencesSummary": { "type": "string" },
        "totalInteractions": { "type": "number" },
        "lastEvolvedAt": { "type": "string" }
      },
      "required": ["assistantId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profils des utilisateurs inscrits"
    },
    "/assistants/{assistantId}": {
      "schema": "Assistant",
      "description": "Assistants IA configurés par les utilisateurs"
    },
    "/prospects/{prospectId}": {
      "schema": "Prospect",
      "description": "Prospects capturés par l'assistant"
    },
    "/conversation_contexts/{contextId}": {
      "schema": "ConversationContext",
      "description": "Historique des messages et contexte de conversation"
    },
    "/evolving_memories/{assistantId}": {
      "schema": "EvolvingMemory",
      "description": "Profil de contexte évolutif et d'apprentissage continu de l'assistant"
    },
    "/instagram_integrations/{userId}": {
      "description": "Données d'authentification et de configuration de l'intégration Instagram"
    }
  }
}
